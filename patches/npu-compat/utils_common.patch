# [npu-compat] 新增 slime/utils/common.py 提供 is_npu()，所有 npu-compat 补丁的公共依赖，须最先应用。详见 patches/MANIFEST.toml
diff --git a/slime/utils/common.py b/slime/utils/common.py
new file mode 100644
index 0000000..e7b7a9f
--- /dev/null
+++ b/slime/utils/common.py
@@ -0,0 +1,13 @@
+import torch
+
+
+def is_npu() -> bool:
+    if not hasattr(torch, "npu"):
+        return False
+
+    if not torch.npu.is_available():
+        raise RuntimeError(
+            "torch_npu detected, but NPU device is not available or visible."
+        )
+
+    return True
