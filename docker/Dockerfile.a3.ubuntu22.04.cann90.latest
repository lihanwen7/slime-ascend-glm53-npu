FROM swr.cn-south-1.myhuaweicloud.com/ascendhub/cann:9.0.0-a3-ubuntu22.04-py3.11

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG SLIME_ASCEND_REPO=https://gitcode.com/gcw_8jFUVqc5/slime-ascend.git
ARG SLIME_ASCEND_REF=v0.3.2
ENV http_proxy=$HTTP_PROXY
ENV https_proxy=$HTTPS_PROXY
ENV HTTP_PROXY=$HTTP_PROXY
ENV HTTPS_PROXY=$HTTPS_PROXY
ENV GIT_SSL_NO_VERIFY=true

ARG MEGATRON_COMMIT=1dcf0dafa
ARG CANN_VERSION=9.0.0
ARG SGLANG_COMMIT=0.5.15.post1
ARG SGLANG_BASE_COMMIT=0b3bb0cbe31873994c9f989fddfe2f87ca839fdd
ARG SGLANG_ROUTER_PACKAGE=sglang-router==0.3.2
ARG SGL_KERNEL_NPU_VERSION=2026.6.2
ARG SGL_KERNEL_NPU_WHEEL_VERSION=2026.6.1
ARG SGL_KERNEL_NPU_FIX_COMMIT=9765e27532b8f854717eba1d3fb9a0bb97a0c887
ARG MEMFABRIC_HYBRID_VERSION=1.0.8
ARG MBRIDGE_COMMIT=89eb10887887bc74853f89a4de258c0702932a1c
ARG MEGATRON_ADAPTOR_COMMIT=f707a3b6eb9981532c3419c08ea40a8bb5962af5
ARG MEGATRON_BRIDGE_COMMIT=35b4ebfc486fb15dcc0273ceea804c3606be948a
ARG TRANSFORMER_ENGINE_NPU_COMMIT=2b8529f94c3fd10497bf772bdc5b448b7ed4659a
ARG MegatronAdaptor_COMMIT=${MEGATRON_ADAPTOR_COMMIT}
ARG TransformerEngineNPU_COMMIT=${TRANSFORMER_ENGINE_NPU_COMMIT}
# 默认交付 A3 aarch64；x86_64 构建可覆盖 SGL_KERNEL_NPU_ARCH。
ARG SGL_KERNEL_NPU_ARCH=aarch64
ARG SGL_KERNEL_NPU_DEVICE=a3
ARG SGL_KERNEL_NPU_URL=https://github.com/sgl-project/sgl-kernel-npu/releases/download/${SGL_KERNEL_NPU_VERSION}/sgl-kernel-npu-${SGL_KERNEL_NPU_VERSION}-torch2.10.0-py311-cann${CANN_VERSION}-${SGL_KERNEL_NPU_DEVICE}-${SGL_KERNEL_NPU_ARCH}.zip

WORKDIR /workspace

# 基础系统依赖
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
        gcc g++ cmake libnuma-dev wget git curl jq vim build-essential unzip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* && \
    pip install --upgrade pip packaging setuptools==80.10.2 && \
    pip cache purge

# 环境变量设置
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
        export LD_LIBRARY_PATH=/usr/local/Ascend/ascend-toolkit/latest/aarch64-linux/devlib/linux/aarch64:$LD_LIBRARY_PATH; \
    elif [ "$ARCH" = "x86_64" ]; then \
        export LD_LIBRARY_PATH=/usr/local/Ascend/ascend-toolkit/latest/x86_64-linux/devlib/linux/x86_64/:$LD_LIBRARY_PATH; \
    fi && \
    source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
    source /usr/local/Ascend/nnal/atb/set_env.sh

# 配置 Git 全局信息（git am 需要）
RUN git config --global user.email "temp@example.com" && \
    git config --global user.name "temp"

# 【核心前置】从私仓获取本仓（含 patches/ 与 build.sh）。
RUN git clone --branch "${SLIME_ASCEND_REF}" --depth 1 "${SLIME_ASCEND_REPO}" /workspace/slime-ascend && \
    cd /workspace/slime-ascend && \
    git submodule update --init --recursive && \
    test "$(git symbolic-ref --short HEAD)" = "${SLIME_ASCEND_REF}"

RUN cd /workspace/slime-ascend/slime && pip install -e .

# 1. 安装 SGLang
RUN git clone https://github.com/sgl-project/sglang.git /workspace/sglang && \
    cd /workspace/sglang && \
    git checkout v${SGLANG_COMMIT} && \
    test "$(git rev-parse HEAD)" = "${SGLANG_BASE_COMMIT}" && \
    mv python/pyproject.toml python/pyproject.toml.backup && \
    mv python/pyproject_npu.toml python/pyproject.toml && \
    pip install -e "python[all_npu]"

# 2. 安装基础包
RUN pip install \
        torch==2.10.0 \
        torch_npu==2.10.0.post4 \
        torchvision==0.25.0 \
        pybind11==3.0.3 \
        triton_ascend==3.2.1 \
        transformers==5.3.0 \
        memfabric-hybrid==${MEMFABRIC_HYBRID_VERSION} && \
    pip install "${SGLANG_ROUTER_PACKAGE}" --force-reinstall && \
    python -c "import sglang_router" && \
    cd /tmp && \
    wget --no-check-certificate "${SGL_KERNEL_NPU_URL}" -O sgl-kernel-npu-a3.zip && \
    unzip sgl-kernel-npu-a3.zip && \
    pip install torch_memory_saver*.whl && \
    pip install sgl_kernel_npu*.whl && \
    pip install deep_ep*.whl && \
    # 为 deep_ep_cpp 动态库在 site-packages 根目录创建软链接
    cd "$(pip show deep-ep | grep -E '^Location:' | awk '{print $2}')" && \
    ln -s deep_ep/deep_ep_cpp*.so && \
    rm -rf /tmp/*

# The release TMS wheel predates the allocation-lifecycle fix. Rebuild the
# patched native wheel from the exact sgl-kernel-npu source baseline.
RUN git clone https://github.com/sgl-project/sgl-kernel-npu.git /tmp/sgl-kernel-npu-src && \
    cd /tmp/sgl-kernel-npu-src && \
    git checkout ${SGL_KERNEL_NPU_FIX_COMMIT} && \
    git am /workspace/slime-ascend/patches/third_party/sgl-kernel-npu/0001-fix-torch-memory-saver-allocation-lifecycle.patch && \
    git am /workspace/slime-ascend/patches/third_party/sgl-kernel-npu/0002-fix-tms-sglang-cuda-graph-api-and-preload-mode.patch && \
    cd contrib/torch_memory_saver/python && \
    python3 setup.py clean --all && \
    python3 setup.py bdist_wheel && \
    pip install --force-reinstall dist/torch_memory_saver*.whl

# 3. 在线克隆并安装依赖
RUN cd /workspace && \
    # 安装 mbridge
    git clone https://github.com/ISEEKYAN/mbridge.git && \
    cd mbridge && git checkout ${MBRIDGE_COMMIT} && \
    pip install -e . && cd /workspace && \
    # 安装 Megatron-Bridge
    git clone https://github.com/fzyzcjy/Megatron-Bridge.git && \
    cd Megatron-Bridge && git checkout ${MEGATRON_BRIDGE_COMMIT} && cd /workspace && \
    pip install "nvidia-modelopt[torch]>=0.37.0" --no-build-isolation && \
    # 安装 Megatron-LM
    git clone https://github.com/NVIDIA/Megatron-LM.git --recursive && \
    cd Megatron-LM && git checkout ${MEGATRON_COMMIT} && \
    pip install -e . && cd /workspace && \
    # 安装 MA&TE
    git clone https://gitcode.com/Ascend/MegatronAdaptor.git && \
    cd MegatronAdaptor/ && git checkout ${MegatronAdaptor_COMMIT} && \
    pip install -e . && cd .. && \
    git clone https://gitcode.com/Ascend/TransformerEngineNPU.git&&  \
    cd TransformerEngineNPU/ && git checkout ${TransformerEngineNPU_COMMIT} &&  \
    pip install -e . && cd ..

# 4. 收尾清理与环境变量固化
RUN pip uninstall -y \
        triton \
        triton-ascend \
        opencv-python && \
    pip install \
        triton-ascend==3.2.1 \
        --extra-index-url https://triton-ascend.osinfra.cn/pypi/simple/ \
        --trusted-host triton-ascend.osinfra.cn \
        --no-cache-dir && \
    ARCH=$(uname -m) && \
    echo "export LD_LIBRARY_PATH=/usr/local/Ascend/ascend-toolkit/latest/${ARCH}-linux/devlib/linux/${ARCH}:\$LD_LIBRARY_PATH" >> ~/.bashrc && \
    echo "source /usr/local/Ascend/ascend-toolkit/set_env.sh" >> ~/.bashrc && \
    echo "source /usr/local/Ascend/nnal/atb/set_env.sh" >> ~/.bashrc

# 5. 应用 third_party 补丁（patches/third_party/，git am）
RUN cd /workspace/sglang && \
    git am --whitespace=fix /workspace/slime-ascend/patches/third_party/sglang/* && \
    cd /workspace/Megatron-LM && \
    git am --whitespace=fix /workspace/slime-ascend/patches/third_party/megatron/* && \
    cd /workspace/Megatron-Bridge && \
    git am --whitespace=fix /workspace/slime-ascend/patches/third_party/megatron-bridge/* && \
    cd /workspace/mbridge && \
    git am --whitespace=fix /workspace/slime-ascend/patches/third_party/mbridge/*

# 6. 从官方 v0.3.2 submodule 用 git am 回放补丁后安装 Slime。
RUN cd /workspace/slime-ascend && \
    git submodule update --init --recursive && \
    bash build.sh && \
    cd slime && \
    pip install -e . && \
    mkdir -p /workspace/slime-ascend/logs

RUN pip list && unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY

CMD ["/bin/bash"]
